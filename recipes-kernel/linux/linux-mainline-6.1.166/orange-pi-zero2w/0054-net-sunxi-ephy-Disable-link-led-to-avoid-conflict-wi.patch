From 0af96c66fdb6edb02152ab041ab08c1f801d9e26 Mon Sep 17 00:00:00 2001
From: orangepi-xunlong <258384131@qq.com>
Date: Thu, 24 Aug 2023 13:31:57 +0800
Subject: [PATCH 54/57] net: sunxi-ephy: Disable link led to avoid conflict
 with twi2/uart5

---
 drivers/net/phy/sunxi-ephy.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/drivers/net/phy/sunxi-ephy.c b/drivers/net/phy/sunxi-ephy.c
index dd923bd9607c..ce380a9c3991 100644
--- a/drivers/net/phy/sunxi-ephy.c
+++ b/drivers/net/phy/sunxi-ephy.c
@@ -267,9 +267,10 @@ static void ac300_ephy_enable(struct ephy_res *priv)
 
 	phy_write(priv->ac300, 0x00, 0x1fb7); /* clk gating (24MHz clock)*/
 
-	phy_write(priv->ac300, 0x05, 0xa81f);
+	//phy_write(priv->ac300, 0x05, 0xa81f);
+	phy_write(priv->ac300, 0x05, 0xa819);
 
-	phy_write(priv->ac300, 0x06, 0x02);
+	phy_write(priv->ac300, 0x06, 0x00);
 
 	msleep(1000); /* FIXME: fix some board compatible issues. */
 
